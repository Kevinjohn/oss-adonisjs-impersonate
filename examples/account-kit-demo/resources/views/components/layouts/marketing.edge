@layouts.document()
  <header class="header header--floating">
    <div class="header__inner">
      @!logo({ size: 28 })
      <div class="header__right">
        @!themeToggle()
        @if(auth?.user)
          @link({ route: 'dashboard', class: 'btn btn--primary btn--sm' })
            Dashboard
          @end
        @else
          <a href="/login" class="btn btn--ghost btn--sm">Sign in</a>
        @end
      </div>
    </div>
  </header>
  {{{ await $slots.main() }}}
@end
